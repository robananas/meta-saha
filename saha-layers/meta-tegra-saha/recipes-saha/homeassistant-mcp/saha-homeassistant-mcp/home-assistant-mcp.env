HA_URL=http://127.0.0.1:8123
HA_TOKEN_FILE=/data/saha/homeassistant/app-credentials.json
HA_TIMEOUT=10
HA_READ_ONLY=false
HA_ALLOWED_DOMAINS=binary_sensor,light,switch,climate,cover,event,fan,media_player,scene,button,number,select,input_boolean,humidifier,remote,vacuum,lock,notify
HA_ALLOW_LOCK_WRITES=false
HA_ALLOW_FEEDER_WRITES=true
MCP_HOST=0.0.0.0
MCP_PORT=8888
MCP_PATH=/mcp
MCP_PUBLIC_URL=http://127.0.0.1:8888/mcp
HA_EVENT_HISTORY_ENABLED=true
HA_EVENT_HISTORY_LIMIT=50
HA_EVENT_HISTORY_POLL_SECONDS=1
HA_EVENT_HISTORY_PATH=/tmp/ha-mcp-event-history.jsonl
HA_EVENT_HISTORY_PATTERNS=*_lock_event_*,*_exception_occurred_*,*_someone_appeared_*,*_pet_appeared_*,*_detected_babycry_*,*_object_motion_*,*_louder_sound_*,*_food_out_complete_*,*_bowl_gram_changed_*,*_day_food_left_*,*_day_eaten_food_*,*_low_food_intake_remind_*
HOME=/tmp
ADB_VENDOR_KEYS=/tmp/.android/adbkey
TV_ADB_HOST=
TV_ADB_PORT=5555
TV_ADB_WAIT_SECONDS=45
