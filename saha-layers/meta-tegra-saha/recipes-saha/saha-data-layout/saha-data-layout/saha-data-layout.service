[Unit]
Description=Validate Saha DATA directory layout
Requires=data.mount
After=data.mount
Before=run-log-journal.mount systemd-journald.service systemd-journald.socket systemd-journald-dev-log.socket systemd-journald-audit.socket docker.service NetworkManager.service bluetooth.service saha-docker-compose.service saha-s2s.service saha-bt-wifi-provision.service

[Service]
Type=oneshot
ExecStart=/usr/libexec/saha-data-layout
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
