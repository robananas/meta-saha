[Unit]
Description=Validate Saha DATA directory layout
DefaultDependencies=no
Requires=data.mount
After=data.mount
Before=run-log-journal.mount local-fs.target systemd-journald.service docker.service NetworkManager.service bluetooth.service saha-docker-compose.service saha-s2s.service saha-bt-wifi-provision.service shutdown.target
Conflicts=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/saha-data-layout
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
