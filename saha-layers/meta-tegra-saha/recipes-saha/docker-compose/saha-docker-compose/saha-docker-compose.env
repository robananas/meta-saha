# Docker compose stack defaults. Override in /etc/default/saha-docker-compose.
SAHA_DOCKER_COMPOSE_DIR=/opt/roban/compose
SAHA_DOCKER_COMPOSE_FILE=/opt/roban/compose/compose.yaml
SAHA_DOCKER_COMPOSE_ENV=/etc/default/saha-docker-compose
SAHA_DOCKER_COMPOSE_TZ=Asia/Shanghai
SAHA_DOCKER_COMPOSE_PULL=0
SAHA_DOCKER_COMPOSE_WAIT=60
SAHA_HOMEASSISTANT_IMAGE=ghcr.io/home-assistant/home-assistant:2026.7.1
SAHA_HOMEASSISTANT_IMAGE_TAR=/data/preload/homeassistant/image.tar
SAHA_HOMEASSISTANT_MCP_IMAGE=roban-ha-mcp:arm64
SAHA_HOMEASSISTANT_MCP_IMAGE_TAR=/data/preload/homeassistant-mcp/image.tar
SAHA_HOMEASSISTANT_MCP_CREDENTIALS_FILE=/data/saha/homeassistant-mcp/credentials.env
SAHA_MATTER_SERVER_IMAGE=ghcr.io/matter-js/python-matter-server:arm64
SAHA_MATTER_SERVER_IMAGE_TAR=/data/preload/matter-server/image.tar
SAHA_MATTER_PAA_TEMPLATE=/usr/share/saha/matter-server/paa-root-certs
SAHA_ROBAN_WORKFLOW_IMAGE=roban-workflow-api:arm64
SAHA_ROBAN_WORKFLOW_IMAGE_TAR=/data/preload/roban-workflow-api/image.tar
SAHA_WORKFLOW_MCP_IMAGE=roban-workflow-mcp:arm64
SAHA_WORKFLOW_MCP_IMAGE_TAR=/data/preload/workflow-mcp/image.tar
SAHA_WORKFLOW_MCP_CREDENTIALS_FILE=/data/saha/workflow-mcp/credentials.env
SAHA_LIVEKIT_SERVER_IMAGE=livekit/livekit-server:v1.13.4
SAHA_LIVEKIT_SERVER_IMAGE_TAR=/data/preload/livekit-server/image.tar
SAHA_LIVEKIT_AGENT_IMAGE=livekit-agent:arm64
SAHA_LIVEKIT_AGENT_IMAGE_TAR=/data/preload/livekit-agent/image.tar
SAHA_LIVEKIT_CREDENTIALS_FILE=/var/lib/saha/livekit/credentials.env
SAHA_LIVEKIT_API_KEY=roban-local
SAHA_LIVEKIT_API_SECRET=
SAHA_LIVEKIT_AGENT_NAME=roban-agent
OPENAI_API_KEY=
SAHA_HOMEASSISTANT_CONFIG_TEMPLATE=/usr/share/saha/homeassistant/config-default
