SAHA_S2S_COMPOSE_DIR=/opt/roban/s2s
SAHA_S2S_COMPOSE_FILE=/opt/roban/s2s/compose.yaml
SAHA_S2S_PROJECT=saha-s2s
SAHA_S2S_IMAGE=roban-s2s:20260831-mcp-url-fix-arm64
SAHA_S2S_IMAGE_TAR=/data/preload/s2s/image.tar
SAHA_S2S_PORT=8765
SAHA_S2S_WAIT=120
SAHA_COSYVOICE_IMAGE=roban-cosyvoice:arm64
SAHA_COSYVOICE_IMAGE_TAR=/data/preload/cosyvoice/image.tar
SAHA_COSYVOICE_PORT=8766
SAHA_COSYVOICE_WAIT=300
HF_ENDPOINT=https://hf-mirror.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
ROBAN_S2S_ICE_SERVERS=[]
ROBAN_S2S_KWS_PROVIDER=cpu
ROBAN_S2S_VAD_PROVIDER=cpu
ROBAN_S2S_VOICEPRINT_DIR=/var/lib/roban-s2s/voiceprints
ROBAN_S2S_VOICE_REFERENCE_TEMP_DIR=/voice-temp
ROBAN_S2S_SPEAKER_PROVIDER=cpu
