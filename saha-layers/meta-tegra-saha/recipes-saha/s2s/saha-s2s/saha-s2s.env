ROBAN_S2S_WESPEAKER_THRESHOLD=
ROBAN_S2S_TITANET_THRESHOLD=
ROBAN_S2S_STT_PROVIDER=cuda
ROBAN_S2S_TTS_PROVIDER=cuda
ROBAN_S2S_PIPELINE_FACTORY=roban_voice_s2s.production_pipeline:create_pipeline
ROBAN_S2S_KWS_MODEL_REVISION=kws-models:145831594
ROBAN_S2S_VAD_MODEL_REVISION=asr-models:130628817
