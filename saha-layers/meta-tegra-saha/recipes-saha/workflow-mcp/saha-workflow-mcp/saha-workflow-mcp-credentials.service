[Unit]
Description=Create workflow control MCP access credentials
Before=saha-docker-compose.service
Requires=saha-data-layout.service data.mount
After=saha-data-layout.service data.mount

[Service]
Type=oneshot
ExecStart=/usr/bin/saha-workflow-mcp-credentials
RemainAfterExit=yes
User=root
UMask=0077

[Install]
WantedBy=multi-user.target
