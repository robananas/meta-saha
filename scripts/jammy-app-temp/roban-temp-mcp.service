[Unit]
Description=Roban temporary Home Assistant MCP
After=roban-temp-ha-bootstrap.service roban-temp-core.service
Requires=roban-temp-ha-bootstrap.service roban-temp-core.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/libexec/roban-app-temp mcp-start
ExecStop=/usr/local/libexec/roban-app-temp mcp-stop
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
